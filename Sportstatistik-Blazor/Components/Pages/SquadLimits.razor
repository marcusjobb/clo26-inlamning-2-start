@page "/squadlimits"
@inherits PageBase
@inject ISquadLimitService SquadLimitService
@inject ILeagueRepository Repository

<PageTitle>Truppgränser</PageTitle>

<h1>Truppgränser@(season > 0 ? $", säsong {season}" : "")</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<SeasonPicker OnSeasonSelected="LoadSeason" />

<table class="table">
    <thead>
        <tr><th>Lag</th><th>Spelare</th><th>Truppgräns</th><th>Ny gräns</th></tr>
    </thead>
    <tbody>
        @foreach (Team team in teams)
        {
            SquadLimit? limit = limits.FirstOrDefault(l => l.TeamId == team.Id);
            <tr>
                <td>@team.Name</td>
                <td>@playerCounts.GetValueOrDefault(team.Id)</td>
                <td>@(limit is null ? "Ingen gräns" : $"Högst {limit.MaxPlayers}")</td>
                <td>
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" style="width:6rem" inputmode="numeric" @bind="limitTexts[team.Id]" />
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SetLimit(team)">Spara</button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted small">
    När ett lag når 80 % av truppgränsen får användaren en varning, och vid 100 % en annan.
</p>

@code {
    private int season;
    private List<Team> teams = new();
    private List<SquadLimit> limits = new();
    private Dictionary<ObjectId, int> playerCounts = new();
    private Dictionary<ObjectId, string> limitTexts = new();

    private void LoadSeason(int selected)
    {
        season = selected;
        teams = TryGet(Repository.GetAllTeams, new List<Team>());
        playerCounts = teams.ToDictionary(t => t.Id, t => TryGet(() => Repository.GetPlayers(t.Id).Count, 0));
        limits = TryGet(() => SquadLimitService.GetLimits(season), new List<SquadLimit>());
        limitTexts = teams.ToDictionary(t => t.Id, _ => "");
    }

    private void SetLimit(Team team)
    {
        if (!InputParser.TryParseInt(limitTexts[team.Id], 1, 100, out int max))
        {
            ClearMessages();
            ErrorMessage = "Truppgränsen måste vara ett heltal mellan 1 och 100.";
            return;
        }

        if (TryRun(() => SquadLimitService.SetLimit(team.Id, season, max)))
        {
            LoadSeason(season);
            SuccessMessage = $"Truppgränsen för {team.Name} är sparad.";
        }
    }
}
