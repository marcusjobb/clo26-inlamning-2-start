@page "/teams"
@using  MongoDB.Bson
@inherits PageBase
@inject ILeagueRepository Repository

<PageTitle>Lag</PageTitle>

<h1>Lag</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (teams.Count == 0)
{
    <p>Det finns inga lag än.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Namn</th><th>Spelare</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (Team team in teams)
            {
                <tr>
                    <td>@team.Name</td>
                    <td>@playerCounts.GetValueOrDefault(team.Id)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="teams/@team.Id">Visa spelare</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Lägg till lag</h2>
<form class="row g-2" @onsubmit="AddTeam">
    <div class="col-auto">
        <input class="form-control" @bind="newName" placeholder="Till exempel Ummis IF" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>

@code {
    private List<Team> teams = new();
    private Dictionary<ObjectId, int> playerCounts = new();
    private string newName = "";

    protected override void OnInitialized() => LoadTeams();

    private void LoadTeams()
    {
        teams = TryGet(Repository.GetAllTeams, new List<Team>());
        playerCounts = teams.ToDictionary(t => t.Id, t => TryGet(() => Repository.GetPlayers(t.Id).Count, 0));
    }

    private void AddTeam()
    {
        ClearMessages();
        string name = newName.Trim();
        if (name.Length == 0)
        {
            ErrorMessage = "Laget måste ha ett namn.";
            return;
        }

        if (TryRun(() => Repository.AddTeam(new Team { Name = name })))
        {
            LoadTeams();
            SuccessMessage = $"Laget \"{name}\" är tillagt.";
            newName = "";
        }
    }
}
