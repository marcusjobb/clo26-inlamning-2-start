@page "/teams/{Id:int}"
@inherits PageBase
@inject ILeagueRepository Repository
@inject IPositionService PositionService
@inject ISquadLimitService SquadLimits

<PageTitle>@(team?.Name ?? "Lag")</PageTitle>

@if (team is null)
{
    <h1>Laget finns inte</h1>
    <p>Det finns inget lag med nummer @Id. <a href="teams">Tillbaka till lagen</a></p>
    return;
}

<h1>@team.Name</h1>
<p class="text-muted">@players.Count spelare</p>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (players.Count == 0)
{
    <p>Laget har inga spelare än.</p>
}
else
{
    <table class="table mb-4">
        <thead>
            <tr><th>Namn</th><th>Position</th></tr>
        </thead>
        <tbody>
            @foreach (Player player in players)
            {
                <tr>
                    <td>@player.FirstName @player.LastName</td>
                    <td>@player.Position</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5">Lägg till spelare</h2>

@* Fälten följer modellen Player. Tar ni bort ett fält ur modellen, ta bort raden här också. *@
<form class="col-md-6" @onsubmit="AddPlayer">
    <div class="mb-3">
        <label class="form-label" for="position">Position</label>
        <select id="position" class="form-select" @bind="newPlayer.Position">
            @foreach (Position position in positions)
            {
                <option value="@position.Name">@position.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="firstName">Förnamn</label>
        <input id="firstName" class="form-control" @bind="newPlayer.FirstName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="lastName">Efternamn</label>
        <input id="lastName" class="form-control" @bind="newPlayer.LastName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="birthDate">Födelsedatum</label>
        <input id="birthDate" type="date" class="form-control" @bind="newPlayer.BirthDate" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="hairColor">Hårfärg</label>
        <input id="hairColor" class="form-control" @bind="newPlayer.HairColor" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="height">Längd i cm</label>
        <input id="height" class="form-control" @bind="heightText" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="religion">Religion</label>
        <input id="religion" class="form-control" @bind="newPlayer.Religion" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" href="teams">Tillbaka till lagen</a>
</form>

@code {
    [Parameter] public int Id { get; set; }

    private Team? team;
    private List<Player> players = new();
    private List<Position> positions = new();
    private Player newPlayer = new();
    private string heightText = "";

    protected override void OnParametersSet()
    {
        team = TryGet(() => Repository.GetTeam(Id), null);
        if (team is null)
        {
            return;
        }

        positions = TryGet(PositionService.GetAll, new List<Position>());
        LoadPlayers();
        ResetForm();
    }

    private void LoadPlayers() => players = TryGet(() => Repository.GetPlayers(Id), new List<Player>());

    private void ResetForm()
    {
        newPlayer = new Player { TeamId = Id, Position = positions.FirstOrDefault()?.Name ?? "" };
        heightText = "";
    }

    private void AddPlayer()
    {
        ClearMessages();
        if (string.IsNullOrWhiteSpace(newPlayer.FirstName))
        {
            ErrorMessage = "Spelaren måste ha ett förnamn.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newPlayer.Position))
        {
            ErrorMessage = "Välj en position.";
            return;
        }
        if (heightText.Length > 0)
        {
            if (!InputParser.TryParseInt(heightText, 0, 300, out int height))
            {
                ErrorMessage = "Längden måste vara ett heltal mellan 0 och 300.";
                return;
            }
            newPlayer.HeightCm = height;
        }

        Player added = newPlayer;
        if (!TryRun(() => Repository.AddPlayer(added)))
        {
            return;
        }

        LoadPlayers();
        ResetForm();

        // Funktion 6: varning vid 80 % och 100 % av truppgränsen. Säsongen är innevarande år.
        // Spelaren är redan sparad, så meddelandet om att den är tillagd ska synas även om
        // varningen inte är byggd än.
        List<string> warnings = TryGet(() => SquadLimits.CheckSquadLimit(Id, DateTime.Today.Year), new List<string>());
        SuccessMessage = $"{added.FirstName} är tillagd i {team!.Name}.";
        WarningMessage = warnings.Count > 0 ? string.Join(" ", warnings) : null;
    }
}
