@page "/standings"
@inherits PageBase
@inject IStandingsService StandingsService
@inject IResultFormatter Formatter

<PageTitle>Tabell</PageTitle>

<h1>Tabell@(season > 0 ? $", säsong {season}" : "")</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<SeasonPicker OnSeasonSelected="LoadSeason" />

@if (rows.Count == 0)
{
    <p>Inga matcher är spelade den här säsongen.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Lag</th>
                <th class="text-end" title="Spelade matcher">S</th>
                <th class="text-end" title="Vinster">V</th>
                <th class="text-end" title="Oavgjorda">O</th>
                <th class="text-end" title="Förluster">F</th>
                <th class="text-end" title="Gjorda mål">GM</th>
                <th class="text-end" title="Insläppta mål">IM</th>
                <th class="text-end" title="Målskillnad">MS</th>
                <th class="text-end" title="Poäng">P</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < rows.Count; i++)
            {
                StandingRow row = rows[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@row.TeamName</td>
                    <td class="text-end">@row.Played</td>
                    <td class="text-end">@row.Won</td>
                    <td class="text-end">@row.Drawn</td>
                    <td class="text-end">@row.Lost</td>
                    <td class="text-end">@row.GoalsFor</td>
                    <td class="text-end">@row.GoalsAgainst</td>
                    <td class="text-end">@Formatter.FormatGoalDifference(row.GoalDifference)</td>
                    <td class="text-end fw-bold">@row.Points</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted small">
        S = spelade, V = vinster, O = oavgjorda, F = förluster, GM = gjorda mål, IM = insläppta mål,
        MS = målskillnad, P = poäng. Vinst ger 3 poäng, oavgjort 1 och förlust 0.
    </p>
}

@code {
    private int season;
    private List<StandingRow> rows = new();

    private void LoadSeason(int selected)
    {
        season = selected;
        rows = TryGet(() => StandingsService.GetStandings(season), new List<StandingRow>());
    }
}
