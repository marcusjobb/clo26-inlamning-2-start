@page "/positions"
@inherits PageBase
@inject IPositionService PositionService

<PageTitle>Positioner</PageTitle>

<h1>Positioner</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

<table class="table">
    <thead>
        <tr><th>Namn</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (Position position in positions)
        {
            <tr>
                <td>@position.Name</td>
                <td class="text-end">
                    @if (pendingDelete?.Id == position.Id)
                    {
                        <span class="me-2">Spelarna med positionen flyttas till "Övrigt". Fortsätta?</span>
                        <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Ja, ta bort</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => pendingDelete = null">Nej</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = position">Ta bort</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 mt-4">Lägg till position</h2>
<form class="row g-2" @onsubmit="AddPosition">
    <div class="col-auto">
        <input class="form-control" @bind="newName" placeholder="Till exempel Libero" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lägg till</button>
    </div>
</form>

@code {
    private List<Position> positions = new();
    private string newName = "";
    private Position? pendingDelete;

    protected override void OnInitialized() => LoadPositions();

    private void LoadPositions() => positions = TryGet(PositionService.GetAll, new List<Position>());

    private void AddPosition()
    {
        // Ingen kontroll av tom text här: den regeln hör hemma i PositionService.
        string name = newName;
        if (TryRun(() => PositionService.Add(name)))
        {
            LoadPositions();
            SuccessMessage = $"Positionen \"{name}\" är tillagd.";
            newName = "";
        }
    }

    private void ConfirmDelete()
    {
        Position position = pendingDelete!;
        pendingDelete = null;

        if (TryRun(() => PositionService.Delete(position.Id)))
        {
            LoadPositions();
            SuccessMessage = $"Positionen \"{position.Name}\" är borttagen.";
        }
    }
}
