@page "/matches"
@inherits PageBase
@inject ILeagueRepository Repository
@inject IResultFormatter Formatter

<PageTitle>Matcher</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Matcher</h1>
    <a class="btn btn-primary" href="matches/create">Registrera match</a>
</div>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (matches.Count == 0)
{
    <p>Det finns inga matcher än.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Hemmalag</th><th>Bortalag</th><th>Resultat</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (Match match in matches)
            {
                <tr>
                    @* Du behöver bygga ut detta mer: visa datum och anteckning när modellen Match har dem. *@
                    <td>@TeamName(match.HomeTeamId)</td>
                    <td>@TeamName(match.AwayTeamId)</td>
                    <td>@Formatter.FormatResult(match.HomeGoals, match.AwayGoals)</td>
                    <td class="text-end">
                        @if (pendingDelete?.Id == match.Id)
                        {
                            @* Önskemål 5: bekräfta innan något tas bort. "Nej" lämnar allt oförändrat. *@
                            <span class="me-2">Är du säker?</span>
                            <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Ja, ta bort</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Nej</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = match">Ta bort</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Match> matches = new();
    private Match? pendingDelete;

    // Du behöver bygga ut detta mer: sortera på datum när Match har ett datum.
    protected override void OnInitialized() => LoadMatches();

    private void LoadMatches() => matches = TryGet(Repository.GetAllMatches, new List<Match>());

    private string TeamName(ObjectId teamId) =>
    Repository.GetTeam(teamId)?.Name ?? "(okänt lag)";

    private void ConfirmDelete()
    {
        Match match = pendingDelete!;
        pendingDelete = null;

        if (TryRun(() => Repository.DeleteMatch(match.Id)))
        {
            LoadMatches();
            SuccessMessage = $"Matchen {TeamName(match.HomeTeamId)} mot {TeamName(match.AwayTeamId)} är borttagen.";
        }
    }

    private void CancelDelete() => pendingDelete = null;
}
