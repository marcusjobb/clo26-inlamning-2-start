
@page "/matches/create"
@using MongoDB.Bson
@inherits PageBase
@inject ILeagueRepository Repository
@inject NavigationManager Navigation

<PageTitle>Registrera match</PageTitle>

<h1>Registrera match</h1>

<PageMessages NotImplemented="NotImplemented" Success="@SuccessMessage" Warning="@WarningMessage" Error="@ErrorMessage" />

@if (validationErrors.Count > 0)
{
    <ul class="text-danger">
        @foreach (string error in validationErrors)
        {
            <li>@error</li>
        }
    </ul>
}

<form class="col-md-8" @onsubmit="Save">
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" for="homeTeam">Hemmalag</label>
            <select id="homeTeam" class="form-select" @bind="homeTeamId">
                @foreach (Team team in teams)
                {
                    <option value="@team.Id">@team.Name</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="awayTeam">Bortalag</label>
            <select id="awayTeam" class="form-select" @bind="awayTeamId">
                @foreach (Team team in teams)
                {
                    <option value="@team.Id">@team.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label" for="homeGoals">Mål hemma</label>
            <input id="homeGoals" class="form-control" inputmode="numeric" @bind="homeGoalsText" placeholder="2" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="awayGoals">Mål borta</label>
            <input id="awayGoals" class="form-control" inputmode="numeric" @bind="awayGoalsText" placeholder="1" />
        </div>
    </div>

    @* Du behöver bygga ut detta mer: fält för datum och anteckning när modellen Match har dem. *@

    <button type="submit" class="btn btn-primary">Spara</button>
    <a class="btn btn-link" href="matches">Avbryt</a>
</form>

@code {
    private List<Team> teams = new();
    private string homeTeamId = "";
    private string awayTeamId = "";
    private string homeGoalsText = "";
    private string awayGoalsText = "";
    private List<string> validationErrors = new();

    protected override void OnInitialized()
    {
        teams = TryGet(Repository.GetAllTeams, new List<Team>());
        homeTeamId = teams.ElementAtOrDefault(0)?.Id.ToString() ?? "";
        awayTeamId = teams.ElementAtOrDefault(1)?.Id.ToString() ?? homeTeamId;
    }

    private void Save()
    {
        validationErrors.Clear();
            if (!ObjectId.TryParse(homeTeamId, out var homeId) ||
            !ObjectId.TryParse(awayTeamId, out var awayId) ||
            Repository.GetTeam(homeId) is null ||
            Repository.GetTeam(awayId) is null)
        {
            validationErrors.Add("Välj både hemmalag och bortalag.");
            return;
        }

        var match = new Match { HomeTeamId = homeId, AwayTeamId = awayId };
     
        if (InputParser.TryParseInt(homeGoalsText, 0, 99, out int homeGoals))
        {
            match.HomeGoals = homeGoals;
        }
        else
        {
            validationErrors.Add($"\"{homeGoalsText}\" är inget giltigt antal mål hemma. Skriv ett heltal mellan 0 och 99.");
        }
        if (InputParser.TryParseInt(awayGoalsText, 0, 99, out int awayGoals))
        {
            match.AwayGoals = awayGoals;
        }
        else
        {
            validationErrors.Add($"\"{awayGoalsText}\" är inget giltigt antal mål borta. Skriv ett heltal mellan 0 och 99.");
        }

        if (validationErrors.Count > 0)
        {
            return;
        }

        // Ingen kontroll av att ett lag möter sig självt här: den regeln hör hemma i repository eller service.
        if (TryRun(() => Repository.AddMatch(match)))
        {
            Navigation.NavigateTo("matches");
        }
    }
}
