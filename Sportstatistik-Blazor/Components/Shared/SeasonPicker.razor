@* Val av säsong. En säsong följer kalenderåret. Används av både tabellen och truppgränserna. *@

<form class="row g-2 align-items-end mb-3" @onsubmit="Submit">
    <div class="col-auto">
        <label class="form-label" for="season">Säsong</label>
        <input id="season" class="form-control" style="width:8rem" @bind="seasonText" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Visa</button>
    </div>
    @if (error is not null)
    {
        <div class="col-12 text-danger">@error</div>
    }
</form>

@code {
    /// <summary>Anropas med säsongen (året) när användaren valt en giltig säsong.</summary>
    [Parameter] public EventCallback<int> OnSeasonSelected { get; set; }

    private string seasonText = "";
    private string? error;

    // Utan val visas innevarande säsong.
    protected override async Task OnInitializedAsync()
    {
        seasonText = DateTime.Today.Year.ToString();
        await Submit();
    }

    private async Task Submit()
    {
        error = null;
        if (!InputParser.TryParseInt(seasonText, 2000, 2100, out int season))
        {
            error = "Skriv en säsong, ett år mellan 2000 och 2100.";
            return;
        }
        await OnSeasonSelected.InvokeAsync(season);
    }
}
